---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page does not exist. Nothing but noise here; the projects and case studies are on the index.">
  <section class="lost" aria-labelledby="lost-h" data-signal="0">
    <p class="lost__code rise">404</p>
    <h1 class="lost__h rise" id="lost-h" style="--d: 0.06s">Nothing but noise here.</h1>
    <p class="lost__p rise" style="--d: 0.18s">This page doesn’t exist. The signal is on the index.</p>
    <a class="btn lost__btn rise" href="/" data-fill style="--d: 0.28s">
      <span class="btn__fill" aria-hidden="true"></span>
      <span class="btn__label">Back to the index</span>
      <span class="btn__arrow" aria-hidden="true">→</span>
    </a>
  </section>
</Base>
