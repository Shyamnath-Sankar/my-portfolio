---
import Base from '../../layouts/Base.astro';
import ProjectKnot from '../../components/ProjectKnot.astro';
import Threads from '../../components/Threads.astro';
import { projects } from '../../data/site';
---
<Base title="Projects" description="AI products by Shyamnath Sankar: LuminaIQ, HailBrowser, SelectStar, AnyLLM and EduEcho, plus smaller open-source tools and experiments.">
  <section class="page-hero" aria-labelledby="work-title">
    <p class="page-hero__kicker" data-reveal="fade" data-intro data-agent-park>Five case studies, one page each</p>
    <h1 class="page-hero__title" id="work-title" data-split="chars" data-intro>Projects</h1>
    <p class="page-hero__lede" data-split="lines" data-intro data-delay="0.2">Products that real people sign in to, download or study with. Each case study shows the problem, the system behind it and what happened.</p>
  </section>
  <section class="work work--page" aria-label="Case studies">
    {projects.map((p, i) => <ProjectKnot project={p} index={i} headingLevel="h2" />)}
  </section>
  <Threads />
</Base>
