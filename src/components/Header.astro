---
import { site } from '../data/site';
const path = Astro.url.pathname;
const nav = [
  { label: 'Projects', href: '/work/', match: (p: string) => p.startsWith('/work') },
  { label: 'About', href: '/about/', match: (p: string) => p.startsWith('/about') },
];
---
<header class="frame">
  <a class="frame__name" href="/" aria-label={`${site.name}, home`}>
    <svg class="frame__mark" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 15c3-7 5-7 7 0s4 7 6 0 4-7 7 0" /></svg>
    <span>{site.name}</span>
  </a>
  <nav class="frame__nav" aria-label="Main">
    <ul>
      {nav.map((n) => (
        <li><a class="draw" href={n.href} aria-current={n.match(path) ? 'page' : undefined}>{n.label}</a></li>
      ))}
      <li><a class="draw" href={`mailto:${site.email}`}>Email</a></li>
    </ul>
  </nav>
  <button class="frame__motion" type="button" aria-pressed="false" data-motion-toggle>
    <span class="frame__motion-dot" aria-hidden="true"></span><span data-motion-label>Motion on</span>
  </button>
  <button class="frame__menu" type="button" aria-expanded="false" aria-controls="menu" data-menu-btn>
    <span class="frame__menu-open">Menu</span><span class="frame__menu-close">Close</span>
  </button>
</header>
<nav id="menu" class="menu" aria-label="Menu" hidden data-menu>
  <ul>
    <li><a href="/" aria-current={path === '/' ? 'page' : undefined}><span>Index</span></a></li>
    {nav.map((n) => <li><a href={n.href} aria-current={n.match(path) ? 'page' : undefined}><span>{n.label}</span></a></li>)}
    <li><a href={`mailto:${site.email}`}><span>Email</span></a></li>
  </ul>
  <p class="menu__foot">{site.city}, {site.coords}</p>
</nav>
