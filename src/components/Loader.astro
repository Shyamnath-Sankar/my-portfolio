---
// First load (desktop, home only). The counter follows real loading; the field resolves behind it.
---
<div id="loader" role="status" aria-label="Loading">
  <div class="loader__log">
    <p data-loader-out class="loader__name">Shyamnath Sankar</p>
    <p data-loader-out class="loader__task">Finding the signal</p>
  </div>
  <p class="loader__count" data-loader-out><span data-loader-count>000</span></p>
  <div class="loader__bar" data-loader-bar></div>
</div>
