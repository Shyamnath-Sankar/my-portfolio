---
// First load (desktop, home only): the agent connects. The counter follows real loading.
---
<div id="loader" role="status" aria-label="Loading">
  <div class="loader__log">
    <p data-loader-out><span class="loader__fn">agent.connect</span>()</p>
    <p data-loader-out class="loader__task">task: “Show me what Shyamnath builds”</p>
    <p data-loader-out class="loader__count"><span data-loader-count>000</span>% loaded</p>
  </div>
  <div class="loader__bar" data-loader-bar></div>
</div>
